# Network binding: 127.0.0.1 = this device only (safe default, localhost).
# To expose BobbinLoom to other devices on your LAN/VPN, set HOST=0.0.0.0 here.
HOST=127.0.0.1
PORT=8787

# Optional request-behaviour overrides (everything else lives in the connection registry)
# Request timeout in ms. Default is 120000 (120s) — reasoning models (e.g. deepseek-v4-pro) can exceed 60s.
BOBBINLOOM_TIMEOUT_MS=120000
# Retries per provider call. Default is 1.
BOBBINLOOM_MAX_RETRIES=1
